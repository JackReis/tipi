{
  "$defs": {
    "Belief": {
      "description": "A durable, subjectively-weighted claim in the belief ledger.\n\nBeliefs are derived \u2014 never raw captures. A write to spirit implies a\nreflection pass over mind. Per the synthesis at the top of this section:\nan unexamined claim does not exist; a Belief is brought into existence\nby the act of grounding it.\n\nOptional dialectic fields (verifier, falsifier, disputation, confidence,\naletheia_sha256) carry the producer-side discipline. They are optional\nfor backwards-compat with existing belief data but should be populated\nfor any belief that participates in cross-agent reconciliation.",
      "properties": {
        "aletheia_sha256": {
          "default": "",
          "title": "Aletheia Sha256",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "confidence": {
          "default": "",
          "title": "Confidence",
          "type": "string"
        },
        "derived_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "disputation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Disputation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "falsifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "subjective_weight": {
          "title": "Subjective Weight",
          "type": "number"
        },
        "timestamp": {
          "default": "",
          "title": "Timestamp",
          "type": "string"
        },
        "verifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "claim",
        "subjective_weight"
      ],
      "title": "Belief",
      "type": "object"
    },
    "BodyState": {
      "description": "Snapshot of the body substrate.",
      "properties": {
        "recent_changes": {
          "default": [],
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Recent Changes",
          "type": "array"
        },
        "repos": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Repos",
          "type": "array"
        }
      },
      "title": "BodyState",
      "type": "object"
    },
    "Check": {
      "description": "A runnable verifier or falsifier command for a Belief.\n\nMirrors peer-grill claims.schema.json: cmd is a shell command,\nexpect is a comparator string (literal | >N | matches:/RE/ | contains: |\nsha256:HEX | lines:OP). Deterministic, sandbox-friendly, retryable.",
      "properties": {
        "cmd": {
          "title": "Cmd",
          "type": "string"
        },
        "expect": {
          "title": "Expect",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 10,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "cmd",
        "expect"
      ],
      "title": "Check",
      "type": "object"
    },
    "Disputation": {
      "description": "Scholastic quaestio-form structured disputation for high-stakes beliefs.\n\nUse only when a belief's stakes earn the structural overhead. Everyday\nbeliefs ratify with verifier + ALETHEIA stamp; contested ones get the\nfull quaestio / obiectiones / sed contra / respondeo / responsiones\ntreatment, with a sha256 attestation when both peers ratify the merged\nstatement.",
      "properties": {
        "aletheia_sha256": {
          "default": "",
          "title": "Aletheia Sha256",
          "type": "string"
        },
        "obiectiones": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Obiectio"
          },
          "title": "Obiectiones",
          "type": "array"
        },
        "quaestio": {
          "title": "Quaestio",
          "type": "string"
        },
        "respondeo": {
          "default": "",
          "title": "Respondeo",
          "type": "string"
        },
        "responsiones": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Responsio"
          },
          "title": "Responsiones",
          "type": "array"
        },
        "sed_contra": {
          "anyOf": [
            {
              "$ref": "#/$defs/SedContra"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "quaestio"
      ],
      "title": "Disputation",
      "type": "object"
    },
    "HandoffFreshness": {
      "description": "How fresh is our cross-session coordination signal?",
      "properties": {
        "age_seconds": {
          "title": "Age Seconds",
          "type": "integer"
        },
        "count_last_24h": {
          "title": "Count Last 24H",
          "type": "integer"
        },
        "newest_file": {
          "title": "Newest File",
          "type": "string"
        }
      },
      "required": [
        "newest_file",
        "age_seconds",
        "count_last_24h"
      ],
      "title": "HandoffFreshness",
      "type": "object"
    },
    "HealthSnapshot": {
      "description": "Composite \u2014 one poll of all four health fields at once.",
      "properties": {
        "handoff_freshness": {
          "$ref": "#/$defs/HandoffFreshness"
        },
        "ob1_sync_status": {
          "$ref": "#/$defs/OB1SyncStatus"
        },
        "project_memory_entries": {
          "$ref": "#/$defs/ProjectMemoryEntries"
        },
        "session_lock_state": {
          "items": {
            "$ref": "#/$defs/SessionLock"
          },
          "title": "Session Lock State",
          "type": "array"
        }
      },
      "required": [
        "handoff_freshness",
        "ob1_sync_status",
        "session_lock_state",
        "project_memory_entries"
      ],
      "title": "HealthSnapshot",
      "type": "object"
    },
    "MindRecord": {
      "description": "A retrieval hit from the mind layer (backend-agnostic).\n\n`backend` discriminates the source: obn | khoj | knowledge-graph | ...",
      "properties": {
        "backend": {
          "default": "obn",
          "title": "Backend",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "id",
        "content",
        "score"
      ],
      "title": "MindRecord",
      "type": "object"
    },
    "OB1SyncStatus": {
      "description": "Current state of the mind-layer index, whichever backend is live.",
      "properties": {
        "backend": {
          "enum": [
            "obn",
            "khoj",
            "ob1",
            "stub"
          ],
          "title": "Backend",
          "type": "string"
        },
        "last_sync": {
          "title": "Last Sync",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "record_count": {
          "title": "Record Count",
          "type": "integer"
        }
      },
      "required": [
        "backend",
        "last_sync",
        "ok",
        "record_count"
      ],
      "title": "OB1SyncStatus",
      "type": "object"
    },
    "Obiectio": {
      "description": "A numbered objection raised against a Belief's quaestio.\n\nLatin disputation form per scholastic tradition (Aquinas Summa I-I).\nEach obiectio cites a source the asker can verify.",
      "properties": {
        "argument": {
          "title": "Argument",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "raised_by": {
          "default": "",
          "title": "Raised By",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "n",
        "argument"
      ],
      "title": "Obiectio",
      "type": "object"
    },
    "PerSessionMemoryEntry": {
      "description": "Per-session breakdown of the vault-native project_memory.json.",
      "properties": {
        "approaching_consolidation": {
          "title": "Approaching Consolidation",
          "type": "boolean"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "count",
        "approaching_consolidation"
      ],
      "title": "PerSessionMemoryEntry",
      "type": "object"
    },
    "ProjectMemoryEntries": {
      "description": "Top-level shape for project_memory.json health.",
      "properties": {
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "per_session": {
          "items": {
            "$ref": "#/$defs/PerSessionMemoryEntry"
          },
          "title": "Per Session",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "limit"
      ],
      "title": "ProjectMemoryEntries",
      "type": "object"
    },
    "Responsio": {
      "description": "A reply to a specific obiectio number, completing the disputation.",
      "properties": {
        "reply": {
          "title": "Reply",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "integer"
        }
      },
      "required": [
        "to",
        "reply"
      ],
      "title": "Responsio",
      "type": "object"
    },
    "SedContra": {
      "description": "The single strongest counter to the obiectiones.\n\nAquinas reserves this for the most authoritative source. Only one\nsed contra per disputation, by convention.",
      "properties": {
        "argument": {
          "title": "Argument",
          "type": "string"
        },
        "raised_by": {
          "default": "",
          "title": "Raised By",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "argument"
      ],
      "title": "SedContra",
      "type": "object"
    },
    "SessionLock": {
      "description": "One lock held on a task in claude/tasks/active/.",
      "properties": {
        "age_minutes": {
          "title": "Age Minutes",
          "type": "integer"
        },
        "lock_acquired": {
          "title": "Lock Acquired",
          "type": "string"
        },
        "locked_by": {
          "title": "Locked By",
          "type": "string"
        },
        "task_slug": {
          "title": "Task Slug",
          "type": "string"
        }
      },
      "required": [
        "task_slug",
        "locked_by",
        "lock_acquired",
        "age_minutes"
      ],
      "title": "SessionLock",
      "type": "object"
    }
  },
  "$id": "tipi/contract/consciousness-interface.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Shared contract between tipi + vs-tipi (IDE enclosure) and the infra-context-dashboard (browser enclosure). Generated from tipi/mcp/consciousness/*.py \u2014 do not edit by hand.",
  "title": "tipi consciousness interface"
}
